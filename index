  <script>
    // =========================================================================
    // [評分與推論門檻常數定義區] - 所有門檻集中於最上方，與頁面說明完全一致
    // =========================================================================
    const MODEL_PATH = './best.onnx';
    const INPUT_SIZE = 640;
    const TARGET_CLASS_ID = 0; // 0 = crosswalk（斑馬線）
    const CONF_THRESHOLD = 0.4;
    const IOU_THRESHOLD = 0.45;
    const ANALYSIS_MAX_SIDE = 256;

    // 指標 1：標線清晰度（灰階 P90 - P10）
    const CLARITY_GOOD_MIN = 80;      // >= 80 -> 0 分
    const CLARITY_WARN_MIN = 50;      // 50 ~ 80 -> 1 分；< 50 -> 2 分

    // 指標 2：框內能見度（平均灰階）
    const VISIBILITY_GOOD_MIN = 70;   // 70 ~ 200 -> 0 分
    const VISIBILITY_GOOD_MAX = 200;
    const VISIBILITY_WARN_MIN = 40;   // 40 ~ 70 或 200 ~ 230 -> 1 分
    const VISIBILITY_WARN_MAX = 230;  // < 40 或 > 230 -> 2 分

    // 指標 3：完整度（距邊緣比例）
    const EDGE_MARGIN_RATIO = 0.02;   // 小於影像對應尺寸 2% -> 1 分

    // 指標 4：視線盲區（底邊距離比例 = (圖高 - (y + h)) / 圖高）
    const BLIND_SPOT_BOTTOM_RATIO = 0.18; // < 0.18 -> 1 分

    // 指標 5：空間壓迫（高度佔比 = h / 圖高）
    const CROWDING_HEIGHT_RATIO = 0.25;   // > 0.25 -> 1 分

    // 總分風險分級門檻（總分 0 ~ 7）
    const RISK_LOW_MAX = 1;           // <= 1 低風險
    const RISK_MID_MAX = 3;           // 2 ~ 3 中風險；>= 4 高風險

    // =========================================================================
    // DOM 元素參考（保留全部 8 個指定 ID）
    // =========================================================================
    const imageInput = document.getElementById('imageInput');
    const statusEl = document.getElementById('status');
    const outputCanvas = document.getElementById('outputCanvas');
    const reportEl = document.getElementById('report');
    const reportTargetsEl = document.getElementById('reportTargets');
    const reportLevelEl = document.getElementById('reportLevel');
    const reportDetailEl = document.getElementById('reportDetail');
    const reportAdviceEl = document.getElementById('reportAdvice');
    const canvasDimText = document.getElementById('canvasDimText');

    let ortSession = null;

    // =========================================================================
    // 分頁籤（Tabs）互動切換邏輯
    // =========================================================================
    document.querySelectorAll('.tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        document.querySelectorAll('.tab-panel').forEach((p) => p.classList.remove('active'));
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        const targetPanel = document.getElementById(btn.dataset.tab);
        if (targetPanel) targetPanel.classList.add('active');
      });
    });

    // =========================================================================
    // 1. 頁面載入時初始化 ONNX 模型
    // =========================================================================
    async function initModel() {
      imageInput.disabled = true;
      statusEl.textContent = '模型載入中（./best.onnx），請稍候...';
      try {
        ortSession = await ort.InferenceSession.create(MODEL_PATH, {
          executionProviders: ['wasm']
        });
        imageInput.disabled = false;
        statusEl.textContent = '模型載入完成，請上傳街景照片開始斑馬線巡檢辨識。';
      } catch (err) {
        console.error('ONNX 模型載入失敗:', err);
        statusEl.textContent = `模型載入失敗：${err.message || err}（請確認 ./best.onnx 與本網頁位於同一目錄並透過 HTTP 伺服器開啟）`;
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      drawPlaceholderCanvas();
      initModel();
    });

    function drawPlaceholderCanvas() {
      const ctx = outputCanvas.getContext('2d');
      ctx.fillStyle = '#242926';
      ctx.fillRect(0, 0, outputCanvas.width, outputCanvas.height);
      ctx.strokeStyle = '#4D5951';
      ctx.setLineDash([6, 6]);
      ctx.strokeRect(24, 24, outputCanvas.width - 48, outputCanvas.height - 48);
      ctx.setLineDash([]);
      ctx.fillStyle = '#A6B2AA';
      ctx.font = '14px "IBM Plex Mono", "Noto Sans TC", monospace';
      ctx.textAlign = 'center';
      ctx.fillText('等待上傳街景照片進行巡檢偵測', outputCanvas.width / 2, outputCanvas.height / 2);
    }

    // =========================================================================
    // 2. 前處理：Letterbox 等比例縮放補灰 rgb(114,114,114) 並轉 CHW Float32
    // =========================================================================
    function preprocessLetterbox(img) {
      const origW = img.naturalWidth || img.width;
      const origH = img.naturalHeight || img.height;

      const scale = Math.min(INPUT_SIZE / origW, INPUT_SIZE / origH);
      const newW = Math.round(origW * scale);
      const newH = Math.round(origH * scale);
      const padX = (INPUT_SIZE - newW) / 2;
      const padY = (INPUT_SIZE - newH) / 2;

      const letterboxCanvas = document.createElement('canvas');
      letterboxCanvas.width = INPUT_SIZE;
      letterboxCanvas.height = INPUT_SIZE;
      const lctx = letterboxCanvas.getContext('2d');

      lctx.fillStyle = 'rgb(114, 114, 114)';
      lctx.fillRect(0, 0, INPUT_SIZE, INPUT_SIZE);
      lctx.drawImage(img, 0, 0, origW, origH, padX, padY, newW, newH);

      const imgData = lctx.getImageData(0, 0, INPUT_SIZE, INPUT_SIZE).data;
      const totalPixels = INPUT_SIZE * INPUT_SIZE;
      const floatData = new Float32Array(3 * totalPixels);

      // CHW 排列：先全部 R，再 G，再 B，數值正規化至 0~1
      for (let i = 0; i < totalPixels; i++) {
        const base = i * 4;
        floatData[i] = imgData[base] / 255.0;
        floatData[totalPixels + i] = imgData[base + 1] / 255.0;
        floatData[2 * totalPixels + i] = imgData[base + 2] / 255.0;
      }

      const inputTensor = new ort.Tensor('float32', floatData, [1, 3, INPUT_SIZE, INPUT_SIZE]);
      return { inputTensor, scale, padX, padY, origW, origH };
    }

    // =========================================================================
    // 3. 後處理：解析輸出維度 [1, 4+numClasses, numBoxes]、還原座標、單類別 NMS
    // =========================================================================
    function computeIoU(boxA, boxB) {
      const x1 = Math.max(boxA.x1, boxB.x1);
      const y1 = Math.max(boxA.y1, boxB.y1);
      const x2 = Math.min(boxA.x2, boxB.x2);
      const y2 = Math.min(boxA.y2, boxB.y2);

      const interW = Math.max(0, x2 - x1);
      const interH = Math.max(0, y2 - y1);
      const interArea = interW * interH;
      if (interArea <= 0) return 0;

      const areaA = Math.max(0, boxA.x2 - boxA.x1) * Math.max(0, boxA.y2 - boxA.y1);
      const areaB = Math.max(0, boxB.x2 - boxB.x1) * Math.max(0, boxB.y2 - boxB.y1);
      const unionArea = areaA + areaB - interArea;
      return unionArea > 0 ? interArea / unionArea : 0;
    }

    function applySingleClassNMS(boxes, iouThreshold) {
      const sorted = [...boxes].sort((a, b) => b.score - a.score);
      const selected = [];
      const suppressed = new Array(sorted.length).fill(false);

      for (let i = 0; i < sorted.length; i++) {
        if (suppressed[i]) continue;
        const current = sorted[i];
        selected.push(current);
        for (let j = i + 1; j < sorted.length; j++) {
          if (suppressed[j]) continue;
          if (computeIoU(current, sorted[j]) > iouThreshold) {
            suppressed[j] = true;
          }
        }
      }
      return selected;
    }

    function postprocessOutput(outputTensor, meta) {
      const dims = outputTensor.dims; // 預期形狀 [1, 5, 8400] 或 [1, 4 + numClasses, numBoxes]
      const data = outputTensor.data;
      const numChannels = dims[1];
      const numBoxes = dims[2];
      const numClasses = numChannels - 4;

      if (numClasses <= TARGET_CLASS_ID) {
        return [];
      }

      const candidates = [];
      const { scale, padX, padY, origW, origH } = meta;

      for (let i = 0; i < numBoxes; i++) {
        // 僅取類別 0（crosswalk）分數
        const score = data[(4 + TARGET_CLASS_ID) * numBoxes + i];
        if (score < CONF_THRESHOLD) continue;

        const cx = data[0 * numBoxes + i];
        const cy = data[1 * numBoxes + i];
        const w = data[2 * numBoxes + i];
        const h = data[3 * numBoxes + i];

        // 還原至原圖座標並限制在原圖範圍內
        let x1 = (cx - w / 2 - padX) / scale;
        let y1 = (cy - h / 2 - padY) / scale;
        let x2 = (cx + w / 2 - padX) / scale;
        let y2 = (cy + h / 2 - padY) / scale;

        x1 = Math.max(0, Math.min(origW, x1));
        y1 = Math.max(0, Math.min(origH, y1));
        x2 = Math.max(0, Math.min(origW, x2));
        y2 = Math.max(0, Math.min(origH, y2));

        const boxW = x2 - x1;
        const boxH = y2 - y1;
        if (boxW <= 1 || boxH <= 1) continue;

        candidates.push({
          x1,
          y1,
          x2,
          y2,
          w: boxW,
          h: boxH,
          score
        });
      }

      return applySingleClassNMS(candidates, IOU_THRESHOLD);
    }

    // =========================================================================
    // 4. 繪製原圖與偵測框（線寬與字體隨原圖大小縮放）
    // =========================================================================
    function renderDetections(img, boxes) {
      const origW = img.naturalWidth || img.width;
      const origH = img.naturalHeight || img.height;

      outputCanvas.width = origW;
      outputCanvas.height = origH;
      canvasDimText.textContent = `${origW} × ${origH} px`;

      const ctx = outputCanvas.getContext('2d');
      ctx.clearRect(0, 0, origW, origH);
      ctx.drawImage(img, 0, 0, origW, origH);

      const baseScale = Math.max(origW, origH) / 640;
      const lineWidth = Math.max(2, Math.round(3 * baseScale));
      const fontSize = Math.max(14, Math.round(18 * baseScale));
      const padH = Math.max(4, Math.round(5 * baseScale));
      const padW = Math.max(6, Math.round(8 * baseScale));

      ctx.font = `700 ${fontSize}px "IBM Plex Mono", "Noto Sans TC", monospace`;
      ctx.textBaseline = 'top';

      boxes.forEach((box) => {
        const confPct = (box.score * 100).toFixed(1);
        const label = `crosswalk ${confPct}%`;

        // 綠色外框 #00FF00
        ctx.strokeStyle = '#00FF00';
        ctx.lineWidth = lineWidth;
        ctx.strokeRect(box.x1, box.y1, box.w, box.h);

        // 標籤有色底
        const textMetrics = ctx.measureText(label);
        const labelW = textMetrics.width + padW * 2;
        const labelH = fontSize + padH * 2;

        let labelX = box.x1;
        let labelY = box.y1 - labelH;
        if (labelY < 0) {
          labelY = box.y1;
        }
        if (labelX + labelW > origW) {
          labelX = Math.max(0, origW - labelW);
        }

        ctx.fillStyle = '#00FF00';
        ctx.fillRect(labelX, labelY, labelW, labelH);

        ctx.fillStyle = '#0B140E';
        ctx.fillText(label, labelX + padW, labelY + padH);
      });
    }

    // =========================================================================
    // 5. 評估報告計算（必須取自未畫框之原圖 img 裁切）
    // =========================================================================
    function analyzePrimaryCrosswalk(img, primaryBox) {
      const origW = img.naturalWidth || img.width;
      const origH = img.naturalHeight || img.height;

      // 從「原圖」裁出該框區域並縮小至最長邊 256 像素
      const cropScale = Math.min(1, ANALYSIS_MAX_SIDE / Math.max(primaryBox.w, primaryBox.h));
      const cropW = Math.max(1, Math.round(primaryBox.w * cropScale));
      const cropH = Math.max(1, Math.round(primaryBox.h * cropScale));

      const cropCanvas = document.createElement('canvas');
      cropCanvas.width = cropW;
      cropCanvas.height = cropH;
      const cctx = cropCanvas.getContext('2d');
      cctx.drawImage(
        img,
        primaryBox.x1,
        primaryBox.y1,
        primaryBox.w,
        primaryBox.h,
        0,
        0,
        cropW,
        cropH
      );

      const pixelData = cctx.getImageData(0, 0, cropW, cropH).data;
      const totalPixels = cropW * cropH;
      const histogram = new Uint32Array(256);
      let graySum = 0;

      for (let i = 0; i < totalPixels; i++) {
        const idx = i * 4;
        const r = pixelData[idx];
        const g = pixelData[idx + 1];
        const b = pixelData[idx + 2];
        const gray = 0.299 * r + 0.587 * g + 0.114 * b;
        graySum += gray;
        const bin = Math.min(255, Math.max(0, Math.round(gray)));
        histogram[bin]++;
      }

      // 用 256 格直方圖計算第 10 與第 90 百分位
      const p10Target = totalPixels * 0.1;
      const p90Target = totalPixels * 0.9;
      let cumulative = 0;
      let p10 = 0;
      let p90 = 255;
      let foundP10 = false;

      for (let bin = 0; bin < 256; bin++) {
        cumulative += histogram[bin];
        if (!foundP10 && cumulative >= p10Target) {
          p10 = bin;
          foundP10 = true;
        }
        if (cumulative >= p90Target) {
          p90 = bin;
          break;
        }
      }

      // 指標 1：標線清晰度（0~2 分）
      const contrast = p90 - p10;
      let clarityScore = 0;
      if (contrast < CLARITY_WARN_MIN) {
        clarityScore = 2;
      } else if (contrast < CLARITY_GOOD_MIN) {
        clarityScore = 1;
      }

      // 指標 2：框內能見度（0~2 分）
      const meanGray = graySum / totalPixels;
      let visibilityScore = 0;
      if (meanGray < VISIBILITY_WARN_MIN || meanGray > VISIBILITY_WARN_MAX) {
        visibilityScore = 2;
      } else if (meanGray < VISIBILITY_GOOD_MIN || meanGray > VISIBILITY_GOOD_MAX) {
        visibilityScore = 1;
      }

      // 指標 3：完整度（0~1 分）
      const nearSides = [];
      if (primaryBox.x1 < origW * EDGE_MARGIN_RATIO) nearSides.push('左側');
      if (origW - primaryBox.x2 < origW * EDGE_MARGIN_RATIO) nearSides.push('右側');
      if (primaryBox.y1 < origH * EDGE_MARGIN_RATIO) nearSides.push('上側');
      if (origH - primaryBox.y2 < origH * EDGE_MARGIN_RATIO) nearSides.push('下側');
      const completenessScore = nearSides.length > 0 ? 1 : 0;

      // 指標 4：視線盲區（0~1 分）
      const bottomDistRatio = (origH - (primaryBox.y1 + primaryBox.h)) / origH;
      const blindSpotScore = bottomDistRatio < BLIND_SPOT_BOTTOM_RATIO ? 1 : 0;

      // 指標 5：空間壓迫（0~1 分）
      const heightRatio = primaryBox.h / origH;
      const crowdingScore = heightRatio > CROWDING_HEIGHT_RATIO ? 1 : 0;

      const totalScore = clarityScore + visibilityScore + completenessScore + blindSpotScore + crowdingScore;

      return {
        contrast,
        clarityScore,
        meanGray,
        visibilityScore,
        nearSides,
        completenessScore,
        bottomDistRatio,
        blindSpotScore,
        heightRatio,
        crowdingScore,
        totalScore
      };
    }

    function updateReportUI(img, boxes) {
      const tbody = reportDetailEl.querySelector('tbody');
      tbody.innerHTML = '';
      reportAdviceEl.innerHTML = '';

      if (boxes.length === 0) {
        // 沒偵測到斑馬線 -> 無法評估（灰 #616161）
        reportTargetsEl.textContent = '偵測到 0 條斑馬線（無有效目標）';
        reportLevelEl.innerHTML = `<span class="badge" style="background-color:#616161;">無法評估</span><span>總分 — / 7</span>`;

        const tr = document.createElement('tr');
        tr.innerHTML = `<td colspan="3" style="text-align:center;color:var(--ink-muted);">未檢出信心 ≥ ${(CONF_THRESHOLD * 100).toFixed(0)}% 之斑馬線，無法進行像素與幾何指標計算</td>`;
        tbody.appendChild(tr);

        const advices = [
          '請確認現場路面標線是否已嚴重磨損、褪色，或遭前車、施工圍籬與積水大面積遮擋。',
          '建議調整拍攝角度，重新提供光線充足、對焦清晰且完整涵蓋路口行人穿越道的前向照片。'
        ];
        advices.forEach((txt) => {
          const li = document.createElement('li');
          li.textContent = txt;
          reportAdviceEl.appendChild(li);
        });

        reportEl.style.display = 'block';
        return;
      }

      // 依信心降序排列，取最高信心者分析
      const sortedBoxes = [...boxes].sort((a, b) => b.score - a.score);
      const topBox = sortedBoxes[0];
      const topConfPct = (topBox.score * 100).toFixed(1);

      reportTargetsEl.textContent = `共偵測到 ${boxes.length} 條斑馬線（以最高信心者分析），最高信心 ${topConfPct}%`;

      const metrics = analyzePrimaryCrosswalk(img, topBox);

      // 風險分級判定
      let levelText = '低風險';
      let badgeColor = '#2e7d32';
      if (metrics.totalScore > RISK_MID_MAX) {
        levelText = '高風險';
        badgeColor = '#c62828';
      } else if (metrics.totalScore > RISK_LOW_MAX) {
        levelText = '中風險';
        badgeColor = '#ef6c00';
      }

      reportLevelEl.innerHTML = `<span class="badge" style="background-color:${badgeColor};">${levelText}</span><span>總分 ${metrics.totalScore} / 7</span>`;

      // 明細列
      const completenessText = metrics.nearSides.length > 0
        ? `貼近${metrics.nearSides.join('、')}`
        : '四邊完整';

      const rows = [
        {
          name: '標線清晰度',
          value: `對比 ${metrics.contrast}`,
          score: `${metrics.clarityScore} / 2`
        },
        {
          name: '框內能見度',
          value: `平均灰階 ${metrics.meanGray.toFixed(1)}`,
          score: `${metrics.visibilityScore} / 2`
        },
        {
          name: '完整度',
          value: completenessText,
          score: `${metrics.completenessScore} / 1`
        },
        {
          name: '視線盲區',
          value: `底邊距離 ${(metrics.bottomDistRatio * 100).toFixed(1)}%`,
          score: `${metrics.blindSpotScore} / 1`
        },
        {
          name: '空間壓迫',
          value: `高度佔比 ${(metrics.heightRatio * 100).toFixed(1)}%`,
          score: `${metrics.crowdingScore} / 1`
        }
      ];

      rows.forEach((row) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td>${row.name}</td><td>${row.value}</td><td class="mono-num">${row.score}</td>`;
        tbody.appendChild(tr);
      });

      // 系統建議：只針對有得分的項目各列一條具體建議
      const adviceList = [];
      if (metrics.clarityScore > 0) {
        adviceList.push(`【標線清晰度異常（${metrics.clarityScore} 分）】框內明暗對比僅 ${metrics.contrast}（門檻 ≥ ${CLARITY_GOOD_MIN}），斑馬線白漆可能已磨損或褪色，建議通報養護單位排程補繪反光標線。`);
      }
      if (metrics.visibilityScore > 0) {
        const lightDesc = metrics.meanGray < VISIBILITY_GOOD_MIN ? '光線過暗、照明不足' : '強光過曝或路面反光強烈';
        adviceList.push(`【框內能見度異常（${metrics.visibilityScore} 分）】區域平均灰階為 ${metrics.meanGray.toFixed(1)}（${lightDesc}），建議檢視路口夜間照明設施或避開逆光時段複查。`);
      }
      if (metrics.completenessScore > 0) {
        adviceList.push(`【完整度扣分（1 分）】斑馬線邊界貼近影像${metrics.nearSides.join('、')}邊緣（小於 2% 邊距），標線可能遭裁切或部分遮蔽，建議退後或調整鏡頭角度拍攝完整路口。`);
      }
      if (metrics.blindSpotScore > 0) {
        adviceList.push(`【視線盲區警示（1 分）】斑馬線底邊距畫面下緣僅 ${(metrics.bottomDistRatio * 100).toFixed(1)}%（門檻 ≥ 18.0%），目標已逼近車頭視線盲區，駕駛通過時應減速並留意兩側行人動態。`);
      }
      if (metrics.crowdingScore > 0) {
        adviceList.push(`【空間壓迫警示（1 分）】斑馬線高度佔畫面 ${(metrics.heightRatio * 100).toFixed(1)}%（門檻 ≤ 25.0%），前向緩衝縱深偏短，建議檢視停止線退縮距離或保持安全車距。`);
      }

      if (adviceList.length === 0) {
        adviceList.push('五項硬體與視角指標皆為 0 分，目前標線清晰度與能見度狀態良好；惟行經路口時仍請減速慢行，隨時留意周邊車況與行人安全。');
      }

      adviceList.forEach((text) => {
        const li = document.createElement('li');
        li.textContent = text;
        reportAdviceEl.appendChild(li);
      });

      reportEl.style.display = 'block';
    }

    // =========================================================================
    // 6. 檔案上傳與完整推論流程控制
    // =========================================================================
    imageInput.addEventListener('change', async (event) => {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      if (!ortSession) {
        statusEl.textContent = '模型尚未載入完成，無法執行辨識。';
        return;
      }

      // 開始新的辨識時先隱藏報告
      reportEl.style.display = 'none';
      statusEl.textContent = `正在讀取影像「${file.name}」並執行 YOLO 推論...`;

      const objectUrl = URL.createObjectURL(file);
      try {
        const img = await loadImageFromUrl(objectUrl);

        // 前處理
        const meta = preprocessLetterbox(img);

        // 模型推論（輸入名稱 images，輸出取第一個 key）
        const feeds = { images: meta.inputTensor };
        const results = await ortSession.run(feeds);
        const firstKey = Object.keys(results)[0];
        const outputTensor = results[firstKey];

        // 後處理與單類別 NMS
        const boxes = postprocessOutput(outputTensor, meta);

        // 繪製結果至 outputCanvas
        renderDetections(img, boxes);

        // 產生評估報告（傳入未畫框之原圖 img）
        updateReportUI(img, boxes);

        statusEl.textContent = `辨識完成：共偵測到 ${boxes.length} 條斑馬線。`;
      } catch (err) {
        console.error('推論過程發生錯誤:', err);
        statusEl.textContent = `辨識失敗：${err.message || err}`;
      } finally {
        // 推論完成後釋放 object URL
        URL.revokeObjectURL(objectUrl);
      }
    });

    function loadImageFromUrl(url) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = () => reject(new Error('無法解碼所選圖片檔案，請確認格式是否正確。'));
        img.src = url;
      });
    }
  </script>
